From 448e0a094f13cf162172310f37d517dc05b218e6 Mon Sep 17 00:00:00 2001
From: wang-bin <wbsecg1@gmail.com>
Date: Sun, 29 Sep 2024 15:59:13 +0800
Subject: [PATCH 30/38] hls: support segments pretend to be gif & png

Detect png/gif magic at the start of the first segment and, when found,
select the mpegts demuxer directly. The HLS layer only decides *which*
demuxer to use; locating the real TS packet boundary is left to the
mpegts demuxer (0x47 + 188-byte alignment resync), so no bytes are
skipped and no offset is assumed.

Relying on av_probe_input_format2() to find png_pipe/gif_pipe is
unreliable: the demuxers may not be compiled in (e.g. Android), and the
subsequent av_probe_input_buffer() would still lose to extension-based
image demuxers (e.g. .webp URLs), misdetecting the segment as an image.

If the mpegts demuxer is not available in the build, fall back to the
original generic probe. All probe/seek return values are checked; a
failed seek back to offset 0 aborts with an error instead of probing at
an unknown position.

Verified with ezdmw HLS (.webp playlist, png-pretending segments,
471-byte PNG header + 184-byte metadata, real TS at offset 655):
generic probe resolves the segment as `png`, this version resolves
h264 1920x1080 + aac. seg_allow_img=1 restores the original behavior.
---
diff --git a/libavformat/hls.c b/libavformat/hls.c
index 0b01f406f6..73eddf7c12 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -222,6 +222,7 @@ typedef struct HLSContext {
     AVIOInterruptCB *interrupt_callback;
     AVDictionary *avio_opts;
     AVDictionary *seg_format_opts;
+    int seg_allow_img;
     char *allowed_extensions;
     char *allowed_segment_extensions;
     int extension_picky;
@@ -2186,7 +2187,42 @@ static int hls_read_header(AVFormatContext *s)
             pls->ctx->max_analyze_duration = s->max_analyze_duration > 0 ? s->max_analyze_duration : 4 * AV_TIME_BASE;
             pls->ctx->interrupt_callback = s->interrupt_callback;
             url = av_strdup(pls->segments[0]->url);
-            ret = av_probe_input_buffer(&pls->pb.pub, &in_fmt, url, NULL, 0, 0);
+            /* Peek at the beginning of the first segment to detect
+             * png/gif-magic-pretending segments, then always restore the
+             * read position. The HLS layer only decides *which* demuxer to
+             * use; finding the real TS packet boundary is the mpegts
+             * demuxer's own job (it resyncs on 0x47 + 188 alignment). Relying
+             * on av_probe_input_format2() to find png_pipe/gif_pipe instead
+             * is unreliable: the demuxers may not be compiled in, and the
+             * subsequent av_probe_input_buffer() would still lose to
+             * extension-based image demuxers (e.g. .webp URLs). */
+            {
+                uint8_t b[10] = { 0 };
+                int n = avio_read(&pls->pb.pub, b, sizeof(b));
+                if ((ret = avio_seek(&pls->pb.pub, 0, SEEK_SET)) < 0) {
+                    av_log(s, AV_LOG_ERROR, "Failed to restore segment read position after signature check: %s\n",
+                           av_err2str(ret));
+                    avformat_free_context(pls->ctx);
+                    pls->ctx = NULL;
+                    av_free(url);
+                    return ret;
+                }
+                if (!c->seg_allow_img &&
+                    ((n >= 8 && !memcmp(b, "\x89PNG\r\n\x1a\n", 8)) ||
+                     (n >= 6 && (!memcmp(b, "GIF87a", 6) || !memcmp(b, "GIF89a", 6))))) {
+                    in_fmt = av_find_input_format("mpegts");
+                    if (in_fmt) {
+                        ret = 0; /* do not carry a stale error from a previous playlist variant */
+                        av_log(s, AV_LOG_INFO, "Segment starts with png/gif magic, using mpegts demuxer\n");
+                    } else {
+                        /* mpegts demuxer not available in this build: fall back to the
+                         * original generic probe instead of inventing a new error path */
+                        ret = av_probe_input_buffer(&pls->pb.pub, &in_fmt, url, NULL, 0, 0);
+                    }
+                } else {
+                    ret = av_probe_input_buffer(&pls->pb.pub, &in_fmt, url, NULL, 0, 0);
+                }
+            }
 
             for (int n = 0; n < pls->n_segments; n++)
                 if (ret >= 0)
@@ -2683,6 +2719,8 @@ static const AVOption hls_options[] = {
         OFFSET(seg_format_opts), AV_OPT_TYPE_DICT, {.str = NULL}, 0, 0, FLAGS},
     {"seg_max_retry", "Maximum number of times to reload a segment on error.",
      OFFSET(seg_max_retry), AV_OPT_TYPE_INT, {.i64 = 0}, 0, INT_MAX, FLAGS},
+    {"seg_allow_img", "Treat PNG/GIF-signature HLS segments as MPEG-TS (0, default); 1 = allow them to participate in generic image probing",
+        OFFSET(seg_allow_img), AV_OPT_TYPE_BOOL, { .i64 = 0}, 0, 1, FLAGS},
     {NULL}
 };
 
